# Application bind
APP_HOST=127.0.0.1
APP_PORT=6200

# Database (relative paths resolved against backend/, regardless of CWD)
DATABASE_URL=sqlite+aiosqlite:///./data/llm_usability.db
SYNC_DATABASE_URL=sqlite:///./data/llm_usability.db

# Logging
LOG_LEVEL=INFO

# Probe defaults
DEFAULT_INTERVAL_SECONDS=300
DEFAULT_TIMEOUT_SECONDS=30
MAX_CONCURRENCY=10
RETENTION_DAYS=30
PROBE_PROMPT=hi
PROBE_MAX_TOKENS=1

# Timezone
TZ=Asia/Shanghai
