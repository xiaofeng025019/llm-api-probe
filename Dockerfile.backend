# syntax=docker/dockerfile:1.7
# Multi-stage build: Node stage builds the frontend, Python stage runs the backend.

# ---------- Stage 1: frontend build ----------
FROM node:22-alpine AS frontend
# pnpm refuses to silently purge a dirty node_modules without a TTY
# (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY). CI=1 makes it proceed.
ENV CI=1
WORKDIR /web
# Copy only the manifests first to leverage layer caching
COPY frontend/package.json frontend/pnpm-workspace.yaml* ./
RUN corepack enable && corepack prepare pnpm@latest --activate \
    && pnpm install --frozen-lockfile=false
COPY frontend/ ./
RUN pnpm build

# ---------- Stage 2: backend runtime ----------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_HOST=0.0.0.0 \
    APP_PORT=6200

# uv for fast dependency installation
RUN pip install uv

WORKDIR /app

# Install backend dependencies first (cache-friendly)
COPY backend/pyproject.toml backend/uv.lock* ./
RUN uv sync --no-dev

# Copy backend source
COPY backend/app ./app
COPY backend/alembic ./alembic
# `alembic.ini` lives next to `alembic/` (sibling, not child) and is
# referenced by absolute path from `app/db/__init__.py:_run_alembic_upgrade`.
COPY backend/alembic.ini ./alembic.ini

# Copy the prebuilt frontend from stage 1
COPY --from=frontend /web/dist /app/frontend_dist

# Ensure data dir exists at runtime
RUN mkdir -p /app/data

EXPOSE 6200

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request,sys; \
  p=os.environ.get('APP_PORT','6200'); \
  r=urllib.request.urlopen(f'http://127.0.0.1:{p}/api/v1/healthz',timeout=3); \
  sys.exit(0 if r.status==200 else 1)"

# Entrypoint: shell form so APP_HOST / APP_PORT from the runtime
# environment (e.g. docker-compose.yml setting APP_PORT=6200) actually
# take effect. `--no-sync` prevents uv from trying to install dependencies
# at container startup; the image was already synced during build.
# See spec §A.11.
CMD ["sh", "-c", "uv run --no-sync uvicorn app.main:app --host ${APP_HOST:-0.0.0.0} --port ${APP_PORT:-6200}"]
