# syntax=docker/dockerfile:1.7
# Multi-stage build: Node stage builds the frontend, Python stage runs the backend.

# ---------- Stage 1: frontend build ----------
FROM node:22-alpine AS frontend
WORKDIR /web
# Copy only the manifests first to leverage layer caching
COPY frontend/package.json frontend/pnpm-workspace.yaml* ./
RUN corepack enable && corepack prepare pnpm@latest --activate \
    && pnpm install --frozen-lockfile=false
COPY frontend/ ./
RUN pnpm build

# ---------- Stage 2: backend runtime ----------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_HOST=127.0.0.1 \
    APP_PORT=8000

# uv for fast dependency installation
RUN pip install uv

WORKDIR /app

# Install backend dependencies first (cache-friendly)
COPY backend/pyproject.toml backend/uv.lock* ./
RUN uv sync --no-dev

# Copy backend source
COPY backend/app ./app
COPY backend/alembic* ./alembic 2>/dev/null || true

# Copy the prebuilt frontend from stage 1
COPY --from=frontend /web/dist /app/frontend_dist

# Ensure data dir exists at runtime
RUN mkdir -p /app/data

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os,urllib.request,sys; \
  p=os.environ.get('APP_PORT','8000'); \
  r=urllib.request.urlopen(f'http://127.0.0.1:{p}/api/v1/healthz',timeout=3); \
  sys.exit(0 if r.status==200 else 1)"

# Entrypoint: shell form so APP_HOST / APP_PORT from the runtime
# environment (e.g. docker-compose.yml setting APP_PORT=6200) actually
# take effect. A previous CMD hardcoded --port 8000 and silently
# ignored compose's port override, leaving the container listening on
# the wrong port — the 127.0.0.1:6200:6200 mapping then hit nothing.
# See spec §A.11.
CMD ["sh", "-c", "uv run uvicorn app.main:app --host ${APP_HOST:-0.0.0.0} --port ${APP_PORT:-8000}"]
